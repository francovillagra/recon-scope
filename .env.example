# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker Compose (postgres service):
DATABASE_URL=postgresql+asyncpg://recon:recon@localhost:5432/recon

# Supabase (production) — use the "Session pooler" connection string and
# replace the scheme: postgresql:// → postgresql+asyncpg://
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Engine (FastAPI / Python) ──────────────────────────────────────────────────
PORT=8000
DEBUG=false

# HS256 secret — generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12

# Comma-separated list of allowed CORS origins (JSON array as string)
CORS_ORIGINS=["http://localhost:3000"]

# ── Scans ─────────────────────────────────────────────────────────────────────
# The engine only connects to PUBLIC Internet addresses. A verified domain whose DNS points to 127.0.0.1, 10.x.x.x,
# 169.254.169.254... is skipped and reported, because otherwise any user could use the engine to look at the
# network it runs in. Set this to true ONLY on a private deployment where scanning your own internal network is
# the point (for example the local docker-compose setup against your own lab). Never on a shared/public service.
ALLOW_PRIVATE_TARGETS=false

# ── Web (Next.js) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Local Postgres (docker-compose only) ─────────────────────────────────────
POSTGRES_USER=recon
POSTGRES_PASSWORD=recon
POSTGRES_DB=recon
