# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker Compose (postgres service):
DATABASE_URL=postgresql+asyncpg://recon:recon@localhost:5432/recon

# Supabase (production) — use the "Session pooler" connection string and
# replace the scheme: postgresql:// → postgresql+asyncpg://
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Engine (FastAPI / Python) ──────────────────────────────────────────────────
PORT=8000
DEBUG=false

# REQUIRED. Signs the session tokens: whoever knows it can log in as anyone. At least 32 characters; the engine
# refuses to start with an empty, short, repetitive or example value. Generate one and keep it out of git:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12

# Allowed web origins (JSON array as string). Exactly the address of your web app, nothing else.
CORS_ORIGINS=["http://localhost:3000"]

# How many reverse proxies sit in front of the engine. Railway = 1. With 0 the engine uses the socket address,
# which behind a proxy is the proxy's: every user would share the same rate-limit counters and the audit log would
# record the proxy's IP. Never set it higher than the real number: the extra hops would be client-controlled.
TRUSTED_PROXY_COUNT=0

# Request bodies larger than this (bytes) get a 413.
MAX_REQUEST_BYTES=1000000

# ── Scans ─────────────────────────────────────────────────────────────────────
# The engine only connects to PUBLIC Internet addresses. A verified domain whose DNS points to 127.0.0.1, 10.x.x.x,
# 169.254.169.254... is skipped and reported, because otherwise any user could use the engine to look at the
# network it runs in. Set this to true ONLY on a private deployment where scanning your own internal network is
# the point (for example the local docker-compose setup against your own lab). Never on a shared/public service.
ALLOW_PRIVATE_TARGETS=false

# Limits (defaults shown). Scans that hit one of them finish with what they have and say so in the report.
# SCAN_MAX_CONCURRENT=3        scans running at once in this process; the rest wait as "queued"
# SCAN_MAX_PER_USER=2          scans a user can have queued or running
# SCAN_MAX_SECONDS=900         time limit of a whole scan
# SCAN_MAX_HOSTS=25            hosts actively scanned (ports / fingerprint) per scan
# SCAN_MAX_SUBDOMAINS=500      names resolved per scan
# MAX_DOMAINS_PER_USER=25
# VERIFICATION_MAX_AGE_DAYS=0  days a domain verification lasts (0 = never expires; 90 recommended for a public service)
# BCRYPT_CONCURRENCY=4         password hashes computed at once (each takes ~250 ms of CPU)
# BCRYPT_MAX_PENDING=64        hashes waiting before the engine answers 503 instead of queueing more

# ── Web (Next.js) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Local Postgres (docker-compose only) ─────────────────────────────────────
POSTGRES_USER=recon
POSTGRES_PASSWORD=recon
POSTGRES_DB=recon
